{
  "name": "coursecore",
  "version": "1.0.0",
  "description": "大学基础课学习平台 - Vite 重构版",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build:training": "node builders/training-builder.js",
    "build:data": "node builders/question-builder.js",
    "fetch:data": "node scripts/fetch-from-supabase.js",
    "validate:data": "node builders/question-builder.js --validate",
    "compress:images": "node builders/compress-images.js",
    "predev": "npm run build:data && npm run fetch:data",
    "dev": "vite",
    "prebuild": "npm run build:data && npm run fetch:data",
    "build": "vite build && node scripts/prerender.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "gray-matter": "^4.0.3",
    "postcss": "^8.4.38",
    "shadcn": "^4.15.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.0",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "easymde": "^2.21.0",
    "marked": "^18.0.7",
    "sortablejs": "^1.15.7",
    "split.js": "^1.6.5"
  }
}
