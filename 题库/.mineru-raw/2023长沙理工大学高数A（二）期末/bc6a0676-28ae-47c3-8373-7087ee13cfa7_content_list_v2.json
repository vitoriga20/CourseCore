        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 设   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "D=\\{(x,y)|a^{2}\\leq x^{2}+y^{2}\\leq b^{2}\\}"
                    },
                    {
                        "type": "text",
                        "content": " ，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D}\\sqrt{x^{2}+y^{2}}d\\sigma=(\\quad)"
                    },
                    {
                        "type": "text",
                        "content": " .\n(A)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "-\\frac{\\pi}{3}(b^{3}-a^{3})"
                    },
                    {
                        "type": "text",
                        "content": "  (B)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{\\pi}{3}(b^{3}-a^{3})"
                    },
                    {
                        "type": "text",
                        "content": "  (C)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "-\\frac{2\\pi}{3}(b^{3}-a^{3})"
                    },
                    {
                        "type": "text",
                        "content": "  (D)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{2\\pi}{3}(b^{3}-a^{3})"
                    }
                ]
            },
            "bbox": [
                78,
                649,
                773,
                724
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5. 下列级数条件收敛的是（）。(A)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} (-1)^n \\frac{1}{\\ln (1+n)}"
                    },
                    {
                        "type": "text",
                        "content": " (B)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} (-1)^n \\frac{1}{n^2}"
                    },
                    {
                        "type": "text",
                        "content": " (C)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} (-1)^n n^2"
                    },
                    {
                        "type": "text",
                        "content": " (D)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} (-1)^n \\frac{\\pi^{n-2}}{3^n}"
                    }
                ]
            },
