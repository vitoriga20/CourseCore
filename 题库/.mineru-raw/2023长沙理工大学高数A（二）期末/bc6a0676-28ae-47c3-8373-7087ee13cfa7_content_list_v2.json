        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 求过点(2,1,3)且与直线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{x + 1}{3} = \\frac{y - 1}{2} = \\frac{z}{-1}"
                    },
                    {
                        "type": "text",
                        "content": " 垂直相交的直线的方程."
