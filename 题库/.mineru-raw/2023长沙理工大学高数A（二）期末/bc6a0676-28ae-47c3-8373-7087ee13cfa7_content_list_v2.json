            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3. 求二元函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y) = x^{2}(2 + y^{2}) + y \\ln y"
