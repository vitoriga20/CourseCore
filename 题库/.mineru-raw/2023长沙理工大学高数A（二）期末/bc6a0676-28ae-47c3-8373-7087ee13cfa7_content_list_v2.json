        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 求曲线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left\\{ \\begin{array}{l} x^{2} + y^{2} - z = 0 \\\\ x^{2} + 2y^{2} + 3z^{2} - 15 = 0 \\end{array} \\right."
                    },
                    {
                        "type": "text",
                        "content": " 在点(1,1,2)处的切线方程."
                    }
