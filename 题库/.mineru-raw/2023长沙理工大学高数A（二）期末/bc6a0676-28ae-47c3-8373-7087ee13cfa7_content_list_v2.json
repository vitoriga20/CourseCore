            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 设平面  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Pi"
                    },
                    {
                        "type": "text",
                        "content": " 通过点(1,1,1)和点(0,1,-1)且垂直于平面  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x + y + z = 0"
                    },
                    {
                        "type": "text",
                        "content": "，则平面  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Pi"
                    },
                    {
                        "type": "text",
                        "content": " 的方程为（）.\n(A)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "2x - y - z = 0"
                    },
                    {
                        "type": "text",
                        "content": "\n(B)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "2x + y - z = 0"
                    },
                    {
                        "type": "text",
                        "content": "\n(C)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "2x + y + z = 0"
                    },
                    {
                        "type": "text",
                        "content": "\n(D)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "3x - 2y - z = 0"
                    }
                ]
            },
            "bbox": [
                78,
                316,
                776,
                363
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 设 D 是第二象限的一个有界闭域，且 0 < y < 1，令   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "T_{1} = \\iint_{D} yx^{3} d\\sigma, \\quad T_{2} = \\iint_{D} y^{2} x^{3} d\\sigma,"
                    },
                    {
                        "type": "equation_inline",
                        "content": "T_{3} = \\iint_{D} \\sqrt{y} x^{3} d\\sigma"
                    },
                    {
                        "type": "text",
                        "content": " ，则（）.\n\n(A)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "T_{1} \\leq T_{2} \\leq T_{3}"
                    },
                    {
                        "type": "text",
                        "content": " \n\n(B)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "T_{2} \\leq T_{1} \\leq T_{3}"
                    },
                    {
                        "type": "text",
                        "content": " \n\n(C)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "T_{3} \\leq T_{2} \\leq T_{1}"
                    },
                    {
                        "type": "text",
                        "content": " \n\n(D)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "T_{3} \\leq T_{1} \\leq T_{2}"
                    }
                ]
            },
            "bbox": [
                78,
                379,
                761,
                491
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3. 下列说法正确的是（）.\n(A)函数   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  处偏导数存在，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  处连续.\n(B)函数   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  处连续，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  处偏导数存在.\n(C)函数   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  处可微，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  处两个偏导数都连续.\n(D)函数   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  处两个偏导数都连续，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x, y)"
                    },
                    {
                        "type": "text",
