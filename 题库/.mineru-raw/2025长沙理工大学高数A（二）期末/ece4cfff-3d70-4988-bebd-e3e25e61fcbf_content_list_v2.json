        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "12.已知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = e^{xy} + yx^2"
                    },
                    {
                        "type": "text",
                        "content": " ，求  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{\\partial^2z}{\\partial x\\partial y}"
                    }
