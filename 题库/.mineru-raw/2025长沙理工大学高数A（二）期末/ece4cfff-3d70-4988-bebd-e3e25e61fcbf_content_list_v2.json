        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "13. 计算二重积分   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D}\\sqrt{x^{2}+y^{2}}d\\sigma"
                    },
                    {
                        "type": "text",
                        "content": " ，其中 D 是圆环形闭区域   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\{(x,y)|a^{2}\\leq x^{2}+y^{2}\\leq b^{2}\\}(0<a<b)"
                    },
                    {
                        "type": "text",
                        "content": " ."
                    }
                ]
            },
            "bbox": [
