                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "11. 求通过点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(1,2,-1)"
                    },
                    {
                        "type": "text",
                        "content": "  且与直线   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left\\{\\begin{aligned} x-2y+z=2 \\\\ 3x+y-z=1 \\end{aligned}\\right."
                    },
                    {
                        "type": "text",
                        "content": "  平行的直线方程."
                    }
