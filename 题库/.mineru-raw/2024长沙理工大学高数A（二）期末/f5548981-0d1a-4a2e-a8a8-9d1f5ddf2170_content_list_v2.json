        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 设  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "|\\vec{a}| = 2, |\\vec{b}| = 5"
                    },
                    {
                        "type": "text",
                        "content": " 且  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\vec{a} \\perp \\vec{b}"
                    },
                    {
                        "type": "text",
                        "content": "，则  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left|\\left(\\vec{a} + \\vec{b}\\right) \\times (3\\vec{a} - \\vec{b})\\right| ="
                    },
                    {
                        "type": "text",
                        "content": " ____."
                    }
                ]
            },
            "bbox": [
                78,
                126,
                596,
                155
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 设   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "u = e^{-x} \\sin \\frac{x}{y}"
                    },
                    {
                        "type": "text",
                        "content": " ，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{\\partial u}{\\partial y}"
                    },
                    {
                        "type": "text",
                        "content": "  在点 (1,1) 处的值为 ____."
                    }
                ]
            },
            "bbox": [
                78,
                168,
                504,
                202
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3.三重积分  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iiint_{x^2 + y^2 + z^2\\leq 4}\\mathrm{d}V ="
                    }
                ]
            },
            "bbox": [
                78,
                216,
                379,
                260
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 设 L 为椭圆   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{x^{2}}{5} + \\frac{y^{2}}{4} = 1"
                    },
                    {
                        "type": "text",
                        "content": " ，其周长为 a，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\oint_{L} (2xy + 4x^{2} + 5y^{2}) ds ="
                    },
                    {
                        "type": "text",
                        "content": " ____ ."
                    }
                ]
            },
            "bbox": [
                77,
                279,
                685,
                323
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5.级数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} \\frac{(-1)^n}{n2^n}"
                    },
                    {
                        "type": "text",
                        "content": " 的和等于 ____."
                    }
                ]
            },
            "bbox": [
