        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "三、计算题(共5题，每题10分，共50分)"
                    }
                ],
                "level": 2
            },
            "bbox": [
                78,
                412,
                468,
                430
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 已知曲线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Gamma: \\begin{cases} x = 1 + t \\\\ y = t \\\\ z = 1 + t^2 \\end{cases}"
                    },
                    {
                        "type": "text",
                        "content": " 上点  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "P"
                    },
                    {
                        "type": "text",
                        "content": " 处的切线与平面  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\pi: x + y - z = 0"
                    },
                    {
                        "type": "text",
                        "content": " 平行，求点  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "P"
                    },
                    {
                        "type": "text",
                        "content": " 的坐标以及曲线在该点处的切线方程."
                    }
                ]
            },
            "bbox": [
                78,
                442,
                915,
                513
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 求函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y) = x^{2} + 2y^{2} - x^{2}y^{2}"
                    },
                    {
                        "type": "text",
                        "content": " 在区域  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "D = \\{(x, y) | x^{2} + y^{2} \\leq 4, y \\geq 0\\}"
                    },
                    {
                        "type": "text",
                        "content": " 上的最大值和最小值."
                    }
                ]
            },
            "bbox": [
                78,
                524,
                794,
                542
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3. 计算二重积分  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{x^2 + y^2 \\leq a^2} (x^2 - 2\\sin x + 3y + 4) d\\sigma"
                    },
                    {
                        "type": "text",
                        "content": "."
                    }
                ]
            },
            "bbox": [
                78,
                557,
                463,
                601
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 计算曲线积分   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "I = \\int_{\\widehat{AO}} (e^{x} \\sin y - 3y) \\, dx + (e^{x} \\cos y - 3) \\, dy"
                    },
                    {
                        "type": "text",
                        "content": " ，其中   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\widehat{AO}"
                    },
                    {
                        "type": "text",
                        "content": "  为由   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A(a,0)"
                    },
                    {
                        "type": "text",
                        "content": "  到   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "O(0,0)"
                    },
                    {
                        "type": "text",
                        "content": "  经过圆   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x^{2} + y^{2} = ax"
                    },
                    {
                        "type": "text",
                        "content": " \n上半部分的路线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(a>0)"
                    },
                    {
                        "type": "text",
                        "content": " ."
                    }
                ]
            },
            "bbox": [
                77,
                619,
                905,
                689
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5.将  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x)=\\frac{x-1}{4-x}"
                    },
                    {
                        "type": "text",
                        "content": " 展开成x-1的幂级数，并求  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f^{(n)}(1)"
                    },
                    {
                        "type": "text",
                        "content": " ."
                    }
                ]
            },
