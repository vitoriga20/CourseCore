                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "7. 空间曲线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left\\{ \\begin{array}{l} x^{2} + y^{2} + z^{2} = 6, \\\\ x + y + z = 0, \\end{array} \\right."
