            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "12. 求  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iiint_{\\Omega} z \\, dv"
                    },
                    {
                        "type": "text",
                        "content": "，其中  "
                    },
