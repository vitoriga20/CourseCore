            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 设  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "L_{1}:\\frac{x-3}{-2}=\\frac{y+4}{-5}=\\frac{z}{3},\\quad L_{2}:\\left\\{\\begin{aligned}&x=3t,\\\\ &y=-1+3t,\\\\ &z=2+7t,\\end{aligned}\\right."
                    },
                    {
                        "type": "text",
                        "content": " 。  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "L_{3}:\\left\\{\\begin{aligned}&x+3y-4z=-1,\\\\ &2x+y-z=0,\\end{aligned}\\right."
                    },
                    {
                        "type": "text",
                        "content": " 则（）.\n(A)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "L_{1} // L_{3}"
                    },
                    {
                        "type": "text",
                        "content": "  (B)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "L_{1} // L_{2}"
                    },
                    {
                        "type": "text",
                        "content": "  (C)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "L_{2} \\perp L_{3}"
                    },
                    {
                        "type": "text",
                        "content": "  (D)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "L_{1} \\perp L_{2}"
                    }
                ]
            },
            "bbox": [
                95,
                329,
                746,
                397
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 已知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": " 由方程  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z^2 - \\frac{y}{x} = 0"
                    },
                    {
                        "type": "text",
                        "content": " 确定，则（）.\n(A)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x\\frac{\\partial z}{\\partial x}-y\\frac{\\partial z}{\\partial y}=0"
                    },
                    {
                        "type": "text",
                        "content": " (B)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x\\frac{\\partial z}{\\partial x}+y\\frac{\\partial z}{\\partial y}=0"
                    },
                    {
                        "type": "text",
                        "content": " (C)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y\\frac{\\partial z}{\\partial x}-x\\frac{\\partial z}{\\partial y}=0"
                    },
                    {
                        "type": "text",
                        "content": " (D)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(\\frac{\\partial z}{\\partial x})^{2}+(\\frac{\\partial z}{\\partial y})^{2}=0"
                    }
                ]
            },
            "bbox": [
                95,
                401,
                665,
                508
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3. 设   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\lim_{(x,y)\\to(0,0)}\\frac{f(x,y)-f(0,0)+2x-y}{\\sqrt{x^{2}+y^{2}}}=0"
                    },
                    {
                        "type": "text",
                        "content": " ，则   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x,y)"
                    },
                    {
                        "type": "text",
                        "content": "  在点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(0,0)"
                    },
                    {
                        "type": "text",
                        "content": "  处（）.\n(A) 不连续\n(B) 连续但两个偏导数不存在\n(C) 可微\n(D) 两个偏导数存在但不可微"
                    }
                ]
            },
            "bbox": [
                95,
                514,
                700,
                596
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 设   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "D = \\{(x, y) | x^{2} + y^{2} \\leq 1, y \\geq 0\\}"
                    },
                    {
                        "type": "text",
                        "content": " ,   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "D_{1} = \\{(x, y) | x^{2} + y^{2} \\leq 1, x \\geq 0, y \\geq 0\\}"
                    },
                    {
                        "type": "text",
                        "content": " ，则（）.\n(A)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D}|x|dxdy=2\\iint_{D_{1}}xdxdy"
                    },
                    {
                        "type": "text",
                        "content": " \n\n(B)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D}xy\\,dxdy=2\\iint_{D_{1}}xy\\,dxdy"
                    },
                    {
                        "type": "text",
                        "content": " \n\n(C)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D}x\\,dxdy=2\\iint_{D_{1}}x\\,dxdy"
                    },
                    {
                        "type": "text",
                        "content": " \n\n(D)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D}(x+y)dxdy=2\\iint_{D_{1}}(x+y)dxdy"
                    }
                ]
            },
            "bbox": [
                95,
                611,
                786,
                736
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5. 若级数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} a_n"
                    },
                    {
                        "type": "text",
                        "content": " 收敛，则级数（）收敛.\n(A)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} |a_n|"
                    },
                    {
                        "type": "text",
                        "content": "\n(B)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} (-1)^n a_n"
                    },
                    {
                        "type": "text",
                        "content": "\n(C)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} a_n a_{n+1}"
                    },
                    {
                        "type": "text",
                        "content": "\n(D)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty} \\frac{a_n + a_{n+1}}{2}"
                    }
                ]
            },
