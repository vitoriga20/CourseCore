                    },
                    {
                        "type": "equation_inline",
                        "content": "C"
                    },
                    {
                        "type": "text",
                        "content": " 为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "|x| + |y| = 1"
                    },
                    {
                        "type": "text",
                        "content": " 的正向，计算曲线积分  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\oint_{C} \\frac{xdy - ydx}{|x| + |y|}"
