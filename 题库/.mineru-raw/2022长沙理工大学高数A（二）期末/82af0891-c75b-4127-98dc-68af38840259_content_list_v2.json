                        "type": "equation_inline",
                        "content": "\\Omega"
                    },
                    {
                        "type": "text",
                        "content": " 是由  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = x^2 + y^2"
                    },
                    {
                        "type": "text",
                        "content": " 及  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = \\sqrt{2 - x^2 - y^2}"
                    },
                    {
                        "type": "text",
                        "content": " 围成的闭区域."
                    }
                ]
            },
            "bbox": [
