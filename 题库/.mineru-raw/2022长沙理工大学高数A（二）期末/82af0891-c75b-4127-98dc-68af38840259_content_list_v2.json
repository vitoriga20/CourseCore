                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "11. 设  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "D = \\left\\{(x, y) \\mid 0 \\leq x \\leq \\frac{\\pi}{2}, 0 \\leq y \\leq \\frac{\\pi}{2} \\right\\}"
                    },
                    {
                        "type": "text",
