        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 设函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "F(u, v)"
                    },
                    {
                        "type": "text",
                        "content": " 具有一阶连续偏导数， "
                    },
                    {
                        "type": "equation_inline",
                        "content": "F_u(0, 1) = 2"
                    },
                    {
                        "type": "text",
                        "content": "， "
                    },
                    {
                        "type": "equation_inline",
                        "content": "F_v(0, 1) = -3"
                    },
                    {
                        "type": "text",
                        "content": "，则曲面  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "F(x - y + z, xy - yz + zx) = 0"
                    },
                    {
                        "type": "text",
                        "content": " 在点  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(2, 1, -1)"
                    },
                    {
                        "type": "text",
                        "content": " 处的切平面方程为 ____."
                    }
                ]
            },
            "bbox": [
                78,
                126,
                910,
                172
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 设函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y, z) = \\left(\\frac{x}{y}\\right)^{\\frac{1}{z}}"
                    },
                    {
                        "type": "text",
                        "content": "，则  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "df|_{(1,1,1)} ="
                    },
                    {
                        "type": "text",
                        "content": " ____."
                    }
                ]
            },
            "bbox": [
                78,
                189,
                482,
                228
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3. 将二次积分   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{0}^{1} dx \\int_{x}^{\\sqrt{x}} f(x, y) dy"
                    },
                    {
                        "type": "text",
                        "content": "  化为极坐标形式的二次积分为 ____."
                    }
                ]
            },
            "bbox": [
                78,
                244,
                658,
                282
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 设   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Omega"
                    },
                    {
                        "type": "text",
                        "content": "  是由 xy = z,   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x + y = 1"
                    },
                    {
                        "type": "text",
                        "content": " , z = 0 所围成的闭区域, 则把三重积分   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iiint_{\\Omega} f(x, y, z) \\, dv"
                    },
                    {
                        "type": "text",
                        "content": "  化成积分次序为   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z \\to y \\to x"
                    },
                    {
                        "type": "text",
                        "content": "  的三次积分为 ____."
                    }
                ]
            },
            "bbox": [
                78,
                290,
                912,
                344
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5.将函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x)=\\ln(2+3x)"
                    },
                    {
                        "type": "text",
                        "content": " 展开成x的幂级数为____."
                    }
                ]
            },
            "bbox": [
