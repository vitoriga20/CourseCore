                380
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "三、计算题(本大题总分50分，共计5小题，每题10分)"
                    }
                ],
                "level": 2
            },
            "bbox": [
                78,
                394,
                588,
                411
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 设  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e^z - xyz = 0"
                    },
                    {
                        "type": "text",
                        "content": "，求  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{\\partial z}{\\partial x}, \\frac{\\partial z}{\\partial y}"
                    },
                    {
                        "type": "text",
                        "content": "."
                    }
                ]
            },
            "bbox": [
                78,
                424,
                300,
                455
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 求函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x, y) = (6x - x^2)(4y - y^2)"
                    },
                    {
                        "type": "text",
                        "content": " 的极值."
                    }
                ]
            },
            "bbox": [
                78,
                500,
                425,
                516
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3. 计算   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{L}(x^{2}-y)dx-(x+\\sin^{2}y)dy"
                    },
                    {
                        "type": "text",
                        "content": " ，其中 L 是在圆周   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y=\\sqrt{2x-x^{2}}"
                    },
                    {
                        "type": "text",
                        "content": "  上由点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(0,0)"
                    },
                    {
                        "type": "text",
                        "content": "  到点   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(1,1)"
                    },
                    {
                        "type": "text",
                        "content": "  的一段弧."
                    }
                ]
            },
            "bbox": [
                78,
                557,
                835,
                595
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 计算  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{\\Sigma} \\left(2x + \\frac{4}{3}y + z\\right) \\mathrm{d}S"
                    },
                    {
                        "type": "text",
                        "content": "，其中  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Sigma"
                    },
                    {
                        "type": "text",
                        "content": " 为平面  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{x}{2} + \\frac{y}{3} + \\frac{z}{4} = 1"
                    },
                    {
                        "type": "text",
                        "content": " 在第一卦限的部分."
                    }
                ]
            },
            "bbox": [
                78,
                640,
                660,
                680
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5.求级数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n = 2}^{\\infty}(-1)^{n}\\frac{n^{2} - n}{2^{n}}"
                    },
                    {
                        "type": "text",
                        "content": " 的和."
                    }
                ]
            },
            "bbox": [
