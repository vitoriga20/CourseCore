        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 以点  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A(1,1,1)"
                    },
                    {
                        "type": "text",
                        "content": " 、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "B(5,2,0)"
                    },
                    {
                        "type": "text",
                        "content": " 、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "C(2,5,0)"
                    },
                    {
                        "type": "text",
                        "content": " 、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "D(1,2,4)"
                    },
                    {
                        "type": "text",
                        "content": " 为顶点的四面体体积为（）.\nA. 12 B. 8\nC. 4 D. 3"
                    }
                ]
            },
            "bbox": [
                78,
                265,
                670,
                334
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2.使  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x^{2}\\frac{\\partial z}{\\partial x}+y^{2}\\frac{\\partial z}{\\partial y}=2z"
                    },
                    {
                        "type": "text",
                        "content": " 成立的是（）.\nA.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z=e^{\\frac{1}{x}+\\frac{1}{y}}"
                    },
                    {
                        "type": "text",
                        "content": " \nB.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z=e^{-\\left(\\frac{1}{x}+\\frac{1}{y}\\right)}"
                    },
                    {
                        "type": "text",
                        "content": " \nC.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = e^{\\frac{1}{x}}"
                    },
                    {
                        "type": "text",
                        "content": " \nD.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = e^{\\frac{1}{y}}"
                    }
                ]
            },
            "bbox": [
                78,
                343,
                588,
                463
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3.设D是由  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x=y^{2}"
                    },
                    {
                        "type": "text",
                        "content": " ，  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x=-y^{2}"
                    },
                    {
                        "type": "text",
                        "content": " ，y=1所围成的闭区域，则  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D}x\\sqrt{x^{2}+y^{2}}d\\sigma=(\\quad)"
                    },
                    {
                        "type": "text",
                        "content": " .\nA. 0\nB. 4\nC. -1\nD. 1"
                    }
                ]
            },
            "bbox": [
                78,
                476,
                717,
                562
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 设   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Sigma"
                    },
                    {
                        "type": "text",
                        "content": "  为平面 x = a, y = a,   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = a (a > 0)"
                    },
                    {
                        "type": "text",
                        "content": "  及三个坐标面所围成的立体的表面的外侧，则\n  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\oint_{\\Sigma}(y^{2}z-x)\\mathrm{d}y\\mathrm{d}z+(z^{2}x-y)\\mathrm{d}z\\mathrm{d}x+(x^{2}y-z)\\mathrm{d}x\\mathrm{d}y()"
                    },
                    {
                        "type": "text",
                        "content": " \nA.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "a^{3}"
                    },
                    {
                        "type": "text",
                        "content": "  B.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "-a^{3}"
                    },
                    {
                        "type": "text",
                        "content": " \nC.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "3a^{3}"
                    },
                    {
                        "type": "text",
                        "content": "  D.   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "-3a^{3}"
                    }
                ]
            },
            "bbox": [
                78,
                571,
                751,
                684
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5.若  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n = 1}^{\\infty}u_n"
                    },
                    {
                        "type": "text",
                        "content": " 收敛，则（）.A.  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n = 1}^{\\infty}|u_n|"
                    },
                    {
                        "type": "text",
                        "content": " 收敛 B.  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n = 1}^{\\infty}(-1)^{n}u_{n}"
                    },
                    {
                        "type": "text",
                        "content": " 收敛C.  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n = 1}^{\\infty}u_nu_{n + 1}"
                    },
                    {
                        "type": "text",
                        "content": " 收敛 D.  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n = 1}^{\\infty}\\frac{u_n + u_{n + 1}}{2}"
                    },
                    {
                        "type": "text",
                        "content": " 收敛"
                    }
                ]
            },
