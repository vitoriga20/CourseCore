                "level": 2
            },
            "bbox": [
                78,
                282,
                457,
                300
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 曲面  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = \\sqrt{x^2 + y^2}"
                    },
                    {
                        "type": "text",
                        "content": " 是（）.\nA、zox平面上曲线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = x"
                    },
                    {
                        "type": "text",
                        "content": " 绕  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z"
                    },
                    {
                        "type": "text",
                        "content": " 轴旋转而成的旋转曲面\nB、zoy平面上曲线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = |y|"
                    },
                    {
                        "type": "text",
                        "content": " 绕  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z"
                    },
                    {
                        "type": "text",
                        "content": " 轴旋转而成的旋转曲面\nC、zox平面上曲线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = x"
                    },
                    {
                        "type": "text",
                        "content": " 绕  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x"
                    },
                    {
                        "type": "text",
                        "content": " 轴旋转而成的旋转曲面\nD、zoy平面上曲线  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = |y|"
                    },
                    {
                        "type": "text",
                        "content": " 绕  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y"
                    },
                    {
                        "type": "text",
                        "content": " 轴旋转而成的旋转曲面"
                    }
                ]
            },
            "bbox": [
                78,
                312,
                557,
                454
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. 函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = f(x, y)"
                    },
                    {
                        "type": "text",
                        "content": " 在点  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(x_0, y_0)"
                    },
                    {
                        "type": "text",
                        "content": " 处偏导数存在，是它在该点存在全微分的（）.\nA、必要条件 B、充分条件\nC、充分必要条件 D、既非充分又非必要条件"
                    }
                ]
            },
            "bbox": [
                78,
                468,
                729,
                550
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3. 设   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(x,y)"
                    },
                    {
                        "type": "text",
                        "content": "  是连续函数，交换二次积分   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{1}^{e} dx \\int_{0}^{lnx} f(x,y) dy"
                    },
                    {
                        "type": "text",
                        "content": "  积分次序的结果为（）.\nA、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{1}^{e}dy\\int_{0}^{lnx}f(x,y)dx"
                    },
                    {
                        "type": "text",
                        "content": "  B、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{e^{y}}^{e}dy\\int_{0}^{1}f(x,y)dx"
                    },
                    {
                        "type": "text",
                        "content": " \nC、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{0}^{lnx}dy\\int_{1}^{e}f(x,y)dx"
                    },
                    {
                        "type": "text",
                        "content": "  D、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{0}^{1}dy\\int_{e^{y}}^{e}f(x,y)dx"
                    }
                ]
            },
            "bbox": [
                78,
                556,
                781,
                665
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. 二重积分  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\iint_{D} f(x, y) \\, dx \\, dy"
                    },
                    {
                        "type": "text",
                        "content": " 的值与（）.\nA、函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f"
                    },
                    {
                        "type": "text",
                        "content": " 及变量  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x, y"
                    },
                    {
                        "type": "text",
                        "content": " 有关 B、区域 D 及变量  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x, y"
                    },
                    {
                        "type": "text",
                        "content": " 无关\nC、函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f"
                    },
                    {
                        "type": "text",
                        "content": " 及区域 D 有关 D、函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f"
                    },
                    {
                        "type": "text",
                        "content": " 无关，区域 D 有关"
                    }
                ]
            },
            "bbox": [
                78,
                671,
                715,
                770
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5. 函数项级数   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sum_{n=1}^{\\infty}\\frac{x^{n}}{n}"
                    },
                    {
                        "type": "text",
                        "content": "  的收敛域是（）.\nA、[-1,1] B、[-1,1) C、(-1,1) D、(-1,1]"
                    }
                ]
            },
